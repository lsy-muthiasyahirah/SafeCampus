@model SafeCampus.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center" style="background-color: #FFD6A5; color: #5C3D2E; border: none;">
                    @TempData["SuccessMessage"]
                </div>
            }

            <!-- Perhatikan penggunaan class card-custom di sini -->
            <div class="card card-custom shadow-lg">
                <div class="card-body p-4">
                    <!-- Perhatikan penggunaan class text-primer di sini -->
                    <h3 class="text-center mb-4 text-primer fw-bold">Masuk</h3>
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold">Username</label>
                            <input asp-for="Username" class="form-control" placeholder="Masukkan username Anda" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="Masukkan password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <!-- Perhatikan penggunaan class btn-aksen di sini -->
                        <button type="submit" class="btn btn-aksen w-100 py-2">Login</button>
                        <div class="text-center mt-4">
                            <!-- Perhatikan penggunaan class link-custom di sini -->
                            Belum punya akun? <a asp-controller="Account" asp-action="Register" class="link-custom">Daftar sekarang</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>