@model SafeCampus.Models.RegisterViewModel
@{
    ViewData["Title"] = "Daftar Akun";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-custom shadow-lg">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primer fw-bold">Daftar Akun Baru</h3>
                    <form asp-action="Register" method="post">

                        <div class="mb-3">
                            <label asp-for="Nama" class="form-label fw-semibold">Nama Lengkap</label>
                            <input asp-for="Nama" class="form-control" placeholder="Masukkan nama lengkap" />
                            <span asp-validation-for="Nama" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NPM" class="form-label fw-semibold">NPM</label>
                            <input asp-for="NPM" class="form-control" placeholder="Masukkan NPM" />
                            <span asp-validation-for="NPM" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="contoh@kampus.edu" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Konfirmasi Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-aksen w-100 py-2">Daftar</button>

                        <div class="text-center mt-4">
                            Sudah punya akun? <a asp-controller="Account" asp-action="Login" class="link-custom">Login di sini</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>