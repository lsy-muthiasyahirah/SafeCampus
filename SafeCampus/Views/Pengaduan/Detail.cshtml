@model SafeCampus.Models.Pengaduan
@using SafeCampus.Models
@{
    ViewData["Title"] = "Pengaduan #" + Model.IdPengaduan;
}

<div class="container" style="max-width: 760px;">
    <div class="sc-header d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1>Pengaduan #@Model.IdPengaduan</h1>
            <p>@Model.Kategori?.NamaKategori</p>
        </div>
        <span class="@Model.Status.CssClass()">@Model.Status.Label()</span>
    </div>

    @if (TempData["Sukses"] is string sukses)
    {
        <div class="sc-alert-sukses">@sukses</div>
    }

    <div class="sc-card">
        <div class="sc-section-title">Data pengaduan</div>
        <dl class="sc-detail row mb-0">
            <div class="col-md-6"><dt>Nama korban</dt><dd>@Model.NamaKorban</dd></div>
            <div class="col-md-6"><dt>NPM korban</dt><dd>@Model.NpmKorban</dd></div>
            <div class="col-md-6"><dt>Tanggal kejadian</dt><dd>@Model.TanggalKejadian.ToString("dd MMMM yyyy")</dd></div>
            <div class="col-md-6"><dt>Lokasi kejadian</dt><dd>@Model.LokasiKejadian</dd></div>
            <div class="col-md-6"><dt>Dikirim pada</dt><dd>@Model.TanggalPengaduan.ToString("dd MMMM yyyy, HH:mm")</dd></div>
            <div class="col-md-6"><dt>Dilaporkan oleh</dt><dd>@(Model.Pelapor?.Nama ?? "-")</dd></div>
            <div class="col-12"><dt>Kronologi</dt><dd class="sc-deskripsi">@Model.Deskripsi</dd></div>
        </dl>
    </div>

    <div class="sc-card">
        <div class="sc-section-title">Bukti pendukung</div>
        @if (!Model.DaftarBukti.Any())
        {
            <p class="text-muted mb-0">Tidak ada bukti yang dilampirkan.</p>
        }
        else
        {
            <div class="sc-bukti">
                @foreach (var b in Model.DaftarBukti)
                {
                    var url = Url.Action("Bukti", "Pengaduan", new { id = b.IdBukti });
                    if (b.IsGambar())
                    {
                        <a href="@url" target="_blank" rel="noopener">
                            <span>
                                <img src="@url" alt="@b.NamaFile" />
                                @b.NamaFile
                            </span>
                        </a>
                    }
                    else
                    {
                        <a href="@url" target="_blank" rel="noopener">@b.NamaFile</a>
                    }
                }
            </div>
        }
    </div>

    @* ===== AREA MODUL SHAFA =====
       Tempel di sini: riwayat status, tanggapan mahasiswa-admin.
       Tiara/Shafa: gunakan class .sc-card agar tampilan seragam. *@

    <div class="mt-3">
        <a asp-action="Riwayat" class="btn btn-sc-outline">&larr; Kembali ke riwayat</a>
    </div>
</div>@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
