@model SafeCampus.Models.KirimTanggapanViewModel
@{
    ViewData["Title"] = "Tanggapan Pengaduan";
}

<div class="container" style="max-width: 700px;">

    <a asp-controller="Pengaduan" asp-action="Detail" asp-route-id="@Model.IdPengaduan"
       class="btn btn-sc-outline mb-3">
        &larr; Kembali ke Detail Pengaduan
    </a>

    <div class="sc-card">
        <div class="sc-section-title">Tanggapan Pengaduan #@Model.IdPengaduan</div>
        <p style="color:#80685B;">
            Sampaikan tanggapan atau informasi tambahan mengenai pengaduan ini.
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger py-2" style="font-size:.88rem;">@TempData["Error"]</div>
        }

        <form asp-action="KirimTanggapan" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdPengaduan" />

            <div class="mb-3">
                <label asp-for="IsiTanggapan" class="form-label fw-semibold"></label>
                <textarea asp-for="IsiTanggapan" class="form-control" rows="7"
                          placeholder="Tuliskan tanggapanmu di sini..." style="resize:vertical;"></textarea>
                <span asp-validation-for="IsiTanggapan" class="text-danger" style="font-size:.85rem"></span>
            </div>

            <div class="d-flex gap-2 justify-content-end">
                <a asp-action="Detail" asp-route-id="@Model.IdPengaduan" class="btn btn-sc-outline">Batal</a>
                <button type="submit" class="btn btn-sc">Kirim Tanggapan &rarr;</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
