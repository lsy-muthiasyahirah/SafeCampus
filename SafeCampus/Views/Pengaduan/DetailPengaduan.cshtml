@model SafeCampus.Models.Pengaduan

@{
    ViewData["Title"] = "Detail Pengaduan";

    var riwayat = ViewBag.Riwayat
        as List<SafeCampus.Models.RiwayatStatus>;

    var tanggapan = ViewBag.Tanggapan
        as List<SafeCampus.Models.Tanggapan>;
}

<style>
    .detail-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .detail-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        border: 1px solid #E9DCD1;
        margin-bottom: 20px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .detail-item {
        background: #FFF8F0;
        padding: 15px;
        border-radius: 10px;
    }

        .detail-item label {
            display: block;
            color: #8B7164;
            font-size: 13px;
            margin-bottom: 7px;
        }

        .detail-item p {
            margin: 0;
            color: #3B2A20;
            font-weight: 500;
            word-break: break-word;
        }

    .detail-full {
        grid-column: 1 / -1;
    }

    .timeline {
        position: relative;
        padding-left: 30px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 8px;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: #E9DCD1;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 30px;
    }

    .timeline-dot {
        position: absolute;
        left: -29px;
        top: 5px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #F28C28;
        border: 3px solid white;
        box-shadow: 0 0 0 1px #F28C28;
    }

    .timeline-item.old .timeline-dot {
        background: #BDBDBD;
        box-shadow: 0 0 0 1px #BDBDBD;
    }

    .timeline-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 15px;
    }

    .timeline-status {
        color: #E76F51;
        font-size: 20px;
        font-weight: 600;
    }

    .timeline-date {
        color: #999;
        font-size: 14px;
    }

    .response-box {
        background: #FFF1E2;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .bottom-action {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .btn-response {
        background: white;
        color: #E76F51;
        border: 1px solid #E76F51;
        padding: 12px 25px;
        border-radius: 10px;
        text-decoration: none;
    }

        .btn-response:hover {
            background: #E76F51;
            color: white;
        }

    .status-current {
        background: #FFF1E2;
        color: #E76F51;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
    }

    .evidence-link {
        color: #E76F51;
        text-decoration: none;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .detail-grid {
            grid-template-columns: 1fr;
        }

        .detail-full {
            grid-column: auto;
        }
    }
</style>

<!-- HEADER -->
<div class="detail-header">
    <a asp-controller="Pengaduan"
       asp-action="Index"
       style="color:#5C3D2E;text-decoration:none;">
        ← Kembali
    </a>

    <h2 class="section-title">Detail Pengaduan</h2>
</div>

<!-- INFORMASI PENGADUAN -->
<div class="detail-card">

    <div style="display:flex;justify-content:space-between;
        align-items:center;flex-wrap:wrap;gap:10px;">

        <h3 style="margin:0">
            Pengaduan #SC-@Model.IdPengaduan
        </h3>

        <span class="status-current">
            @Model.Status
        </span>
    </div>

    <hr style="border:0;border-top:1px solid #E9DCD1;
    margin:20px 0;">

    <h4 style="color:#5C3D2E;margin-bottom:20px;">
        Informasi Korban
    </h4>

    <div class="detail-grid">

        <div class="detail-item">
            <label>Nama Korban</label>
            <p>@Model.NamaKorban</p>
        </div>

        <div class="detail-item">
            <label>NPM Korban</label>
            <p>@Model.NpmKorban</p>
        </div>

        <div class="detail-item">
            <label>Email</label>
            <p>@Model.EmailKorban</p>
        </div>

        <div class="detail-item">
            <label>Jurusan</label>
            <p>@Model.JurusanKorban</p>
        </div>

    </div>

    <h4 style="color:#5C3D2E;margin:25px 0 20px;">
        Informasi Kejadian
    </h4>

    <div class="detail-grid">

        <div class="detail-item">
            <label>Kategori Pengaduan</label>
            <p>@Model.Kategori</p>
        </div>

        <div class="detail-item">
            <label>Tanggal Pengaduan</label>
            <p>
                @Model.TanggalPengaduan.ToString("dd MMMM yyyy")
            </p>
        </div>

        <div class="detail-item">
            <label>Tanggal Kejadian</label>
            <p>
                @Model.TanggalKejadian.ToString("dd MMMM yyyy")
            </p>
        </div>

        <div class="detail-item">
            <label>Lokasi Kejadian</label>
            <p>@Model.LokasiKejadian</p>
        </div>

        <div class="detail-item detail-full">
            <label>Deskripsi Pengaduan</label>
            <p style="white-space:pre-line;">
                @Model.Deskripsi
            </p>
        </div>

        <div class="detail-item detail-full">
            <label>Bukti Pendukung</label>

            @if (!string.IsNullOrEmpty(Model.BuktiPendukung))
            {
                <a href="@Model.BuktiPendukung"
                   target="_blank"
                   class="evidence-link">
                    Lihat Bukti Pendukung →
                </a>
            }
            else
            {
                <p>Belum ada bukti pendukung.</p>
            }
        </div>

    </div>
</div>

<!-- RIWAYAT STATUS -->
<div class="detail-card">

    <h3>Riwayat Status Pengaduan</h3>

    <div class="timeline">

        @if (riwayat != null)
        {
            @foreach (var item in riwayat)
            {
                <div class="timeline-item
                    @(item.StatusSesudahnya == Model.Status
                        ? "" : "old")">

                    <div class="timeline-dot"></div>

                    <div class="timeline-top">

                        <span class="timeline-status">
                            @item.StatusSesudahnya
                        </span>

                        <span class="timeline-date">
                            @item.TanggalPerubahan.ToString(
                                "dd MMM yyyy HH:mm")
                        </span>

                    </div>

                    <p>@item.Keterangan</p>

                </div>
            }
        }

    </div>
</div>

<!-- TANGGAPAN -->
<div class="detail-card">

    <div style="display:flex;justify-content:space-between;
        align-items:center;">

        <h3>Tanggapan</h3>

        <span class="text-muted">
            @(tanggapan?.Count ?? 0) pesan
        </span>

    </div>

    @if (tanggapan != null && tanggapan.Any())
    {
        @foreach (var item in tanggapan)
        {
            <div class="response-box">

                <div style="display:flex;
                    justify-content:space-between;
                    flex-wrap:wrap;">

                    <b>@item.Pengirim</b>

                    <small class="text-muted">
                        @item.TanggalTanggapan.ToString(
                            "dd MMM yyyy HH:mm")
                    </small>

                </div>

                <p style="margin-bottom:0">
                    @item.IsiTanggapan
                </p>

            </div>
        }
    }
    else
    {
        <p class="text-muted">
            Belum ada tanggapan pada pengaduan ini.
        </p>
    }

    <div class="bottom-action">

        <a asp-controller="Pengaduan"
           asp-action="Tanggapan"
           asp-route-id="@Model.IdPengaduan"
           class="btn-response">

            Tanggapi Pengaduan →

        </a>

    </div>

</div>
